<RCC>
    <qresource prefix="/app">
        <file alias="app-icon-rounded.png">../assets/icons/app-icon-rounded.png</file>
        <file alias="app-icon-large-rounded.png">../assets/icons/app-icon-large-rounded.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="power.svg">../assets/icons/power.svg</file>
        <file alias="settings.svg">../assets/icons/settings.svg</file>
        <file alias="app-window.svg">../assets/icons/app-window.svg</file>
        <file alias="maximize-2.svg">../assets/icons/maximize-2.svg</file>
        <file alias="minimize-2.svg">../assets/icons/minimize-2.svg</file>
        <file alias="zoom-out.svg">../assets/icons/zoom-out.svg</file>
        <file alias="zoom-in.svg">../assets/icons/zoom-in.svg</file>
        <file alias="play.svg">../assets/icons/play.svg</file>
        <file alias="circle-play.svg">../assets/icons/circle-play.svg</file>
        <file alias="square-stack.svg">../assets/icons/square-stack.svg</file>
        <file alias="fullscreen.svg">../assets/icons/fullscreen.svg</file>
        <file alias="volume-2.svg">../assets/icons/volume-2.svg</file>
        <file alias="volume-off.svg">../assets/icons/volume-off.svg</file>
        <file alias="usb.svg">../assets/icons/usb.svg</file>
        <file alias="triangle-alert.svg">../assets/icons/triangle-alert.svg</file>
        <file alias="shield.svg">../assets/icons/shield.svg</file>
        <file alias="heart.svg">../assets/icons/heart.svg</file>
        <file alias="file-text.svg">../assets/icons/file-text.svg</file>
        <file alias="info.svg">../assets/icons/info.svg</file>
        <file alias="circle-question-mark.svg">../assets/icons/circle-question-mark.svg</file>
    </qresource>
</RCC>
